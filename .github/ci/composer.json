{
	"name": "uejn/croogo-ci",
	"description": "Esqueleto (croogo/app v2.3.2) para correr los tests de Croogo en el CI",
	"license": "MIT",
	"config": {
		"vendor-dir": "Vendor",
		"platform": {"php": "8.2.0"},
		"allow-plugins": {"composer/installers": true}
	},
	"repositories": [
		{"type": "vcs", "url": "https://github.com/uejn/cakephp"},
		{"type": "vcs", "url": "https://github.com/uejn/migrations"},
		{"type": "path", "url": "..", "options": {"symlink": true, "versions": {"croogo/croogo": "2.3.3"}}}
	],
	"require": {
		"php": ">=8.2",
		"cakephp/cakephp": "2.10.24.6",
		"cakedc/migrations": "2.6.0.1",
		"croogo/croogo": "2.3.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	}
}
